[Unit]
Description=Copia diaria de la base de datos del taller

[Timer]
# A las 20:30, con el taller ya cerrado pero el servidor normalmente encendido.
OnCalendar=*-*-* 20:30:00

# La clave en este taller: el mini-PC se apaga cada noche. Si a las 20:30 ya
# estaba apagado, Persistent hace que la copia se ejecute en cuanto arranca a
# la mañana siguiente, en vez de perderse ese día. Sin esto habría huecos en
# el histórico justo los días que se cierra antes.
Persistent=true

# Un minuto de margen para no pelearse con el arranque de la base de datos
# cuando la copia se dispara nada más encender.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
