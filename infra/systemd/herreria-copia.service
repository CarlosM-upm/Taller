[Unit]
# La copia diaria. La dispara herreria-copia.timer, no se activa al arrancar.
Description=Copia de seguridad de la base de datos del taller
Documentation=file:/opt/herreria/DESPLIEGUE.md
Requires=herreria-bd.service
After=herreria-bd.service

[Service]
Type=oneshot
ExecStart=/opt/herreria/copia-nocturna.sh

# Se ejecuta como root porque tiene que hablar con Docker y escribir en el
# disco USB montado. No expone nada: no escucha en ninguna parte.
User=root
