# /etc/nut/upsd.users
#
# Usuario con el que el monitor (upsmon) habla con el servidor (upsd).
# Todo ocurre dentro del propio mini-PC: upsd solo escucha en 127.0.0.1.
#
# CAMBIAR LA CONTRASEÑA antes de dar el sistema por instalado, y dejar el
# fichero como root:nut con permisos 640:
#
#     sudo chown root:nut /etc/nut/upsd.users
#     sudo chmod 640 /etc/nut/upsd.users

[vigilante]
    password = cambiame-tambien
    upsmon primary
