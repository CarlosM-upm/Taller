#!/bin/bash
#
# /etc/nut/upssched-cmd
#
# Lo llama upssched cuando vence (o se cancela) uno de sus temporizadores.
# Instalar como root:root con permisos 750.
#
set -euo pipefail

case "${1:-}" in
  apagado-por-corte)
    logger -t sai-taller "Sigue sin luz pasados 3 minutos: apagando el servidor del taller"
    # -c fsd avisa a upsmon, que ejecuta SHUTDOWNCMD. systemd para primero la
    # aplicación y después la base de datos, así que PostgreSQL cierra bien.
    /usr/sbin/upsmon -c fsd
    ;;

  apagado-inmediato)
    logger -t sai-taller "Batería baja: apagando el servidor del taller ahora"
    /usr/sbin/upsmon -c fsd
    ;;

  vuelve-la-luz)
    # El caso normal en un taller: un parpadeo y ya está. No se apaga nada.
    logger -t sai-taller "La luz ha vuelto antes de agotar la espera: no se apaga"
    ;;

  *)
    logger -t sai-taller "Aviso del SAI no reconocido: ${1:-sin argumento}"
    ;;
esac
