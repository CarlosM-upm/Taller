<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reglas de PMD sobre el tamaño y la estructura del código Java.

  Límites acordados con el dueño del proyecto (los mismos que ESLint en la PWA):
  250 líneas de código por clase, 40 por método, complejidad 10, complejidad de
  lectura 15 y 3 niveles de if anidados.

  Son OBLIGATORIAS: van enganchadas a "package", y si algo se pasa el jar no se
  construye. A mano, sin empaquetar:  .\mvnw.cmd pmd:check

  NCSS = sentencias de código (Non-Commenting Source Statements): no cuenta
  comentarios, líneas en blanco ni llaves. Medido en este proyecto, una clase
  tiene unas 0,58 NCSS por línea de código: 140 NCSS ≈ 250 líneas, y 25 NCSS en
  un método ≈ 40 líneas.
-->
<ruleset name="Estructura del taller"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Tamaño y complejidad de clases y métodos</description>

    <!-- Tamaño de métodos y clases -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="25"/>
            <property name="classReportLevel" value="140"/>
        </properties>
    </rule>

    <!-- Cuántos caminos tiene un método (cada if, for, case, &&…) -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10"/>
            <property name="classReportLevel" value="80"/>
        </properties>
    </rule>

    <!-- Lo difícil que es de LEER un método: penaliza el anidamiento -->
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="15"/>
        </properties>
    </rule>

    <!-- Clase que hace demasiadas cosas y depende de demasiado -->
    <rule ref="category/java/design.xml/GodClass"/>
    <rule ref="category/java/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="threshold" value="20"/>
        </properties>
    </rule>

    <!-- if dentro de if dentro de if… -->
    <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts">
        <properties>
            <property name="problemDepth" value="3"/>
        </properties>
    </rule>

    <!-- Demasiados parámetros: suele pedir un objeto que los agrupe -->
    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="7"/>
        </properties>
    </rule>
</ruleset>
