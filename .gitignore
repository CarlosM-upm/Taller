# Compilación de Maven
target/

# El wrapper descarga su propio jar; el .properties sí se versiona.
# El patrón lleva ** porque un patrón con barras se anclaría a la raíz
# del repositorio y no cubriría taller-herreria/.mvn/
**/.mvn/wrapper/maven-wrapper.jar

# Registro de la aplicación
logs/
*.log

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/

# Sistema operativo
.DS_Store
Thumbs.db

# Configuración local con credenciales reales (nunca al repositorio)
.env
*-local.yml
application-local.yml
